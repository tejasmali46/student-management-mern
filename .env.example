# Root Environment Variables Template
# Copy this file to server/.env and fill in your actual credentials

# Backend Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://admin_user:YourSecretPass123@cluster0.mongodb.net/student_management?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/student_management?retryWrites=true&w=majority

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Frontend Environment Variable (Place in client/.env during production)
VITE_API_URL=http://localhost:5000/api
